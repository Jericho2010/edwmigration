# Secrets and local runtime state — never commit.
.env

# Agent run output (per-run_id artifacts). Keep the directory, ignore contents.
agents/out/*
!agents/out/.gitkeep

# Rendered / generated SQL (produced by tools)
databricks/_rendered/
databricks/generated/

# Convert run artifacts (engine job is the skeleton; agents write these locally)
databricks/silver/*.sql
databricks/gold/*.sql

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Logs
*.log

# OS / editor
.DS_Store
.idea/
.vscode/

# Databricks
.databricks/
.databricks-resources.json

# Local venv
.venv/
.venv

# Live Azure SQL dumps — never commit; vendored Integration.*.sql stay tracked.
legacy/procs/.export/
legacy/fixtures/*.csv
