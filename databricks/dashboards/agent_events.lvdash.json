{
  "datasets": [
    {
      "name": "gate_hero",
      "displayName": "Gate Hero",
      "queryLines": [
        "SELECT run_id, gate, ",
        "CASE WHEN lower(gate) = 'ship' THEN 1 ELSE 0 END AS gate_pass, ",
        "tables_landed, tables_total, procs_converted, procs_total, updated_at ",
        "FROM ops.migration_manifest_current ",
        "ORDER BY updated_at DESC LIMIT 1 "
      ]
    },
    {
      "name": "inventory_counts",
      "displayName": "Inventory",
      "queryLines": [
        "WITH latest AS ( ",
        "  SELECT COALESCE( ",
        "    (SELECT run_id FROM ops.agent_events ORDER BY ts DESC LIMIT 1), ",
        "    (SELECT run_id FROM ops.migration_manifest_current ORDER BY updated_at DESC LIMIT 1) ",
        "  ) AS run_id ",
        ") ",
        "SELECT object_type, COUNT(*) AS n ",
        "FROM ops.migration_inventory i CROSS JOIN latest ",
        "WHERE i.skip = false AND i.run_id = latest.run_id ",
        "GROUP BY object_type "
      ]
    },
    {
      "name": "reconcile_status",
      "displayName": "Reconcile",
      "queryLines": [
        "WITH latest AS ( ",
        "  SELECT COALESCE( ",
        "    (SELECT run_id FROM ops.agent_events ORDER BY ts DESC LIMIT 1), ",
        "    (SELECT run_id FROM ops.migration_manifest_current ORDER BY updated_at DESC LIMIT 1) ",
        "  ) AS run_id ",
        ") ",
        "SELECT result, COUNT(*) AS checks ",
        "FROM ops.reconcile_results r CROSS JOIN latest ",
        "WHERE r.run_id = latest.run_id ",
        "GROUP BY result "
      ]
    },
    {
      "name": "backlog_status",
      "displayName": "Backlog",
      "queryLines": [
        "SELECT status, COUNT(*) AS items ",
        "FROM ops.migration_backlog ",
        "GROUP BY status "
      ]
    },
    {
      "name": "tables_landed",
      "displayName": "Tables Landed",
      "queryLines": [
        "SELECT table_name, COALESCE(row_count, 0) AS row_count, status, started_at ",
        "FROM ops.load_control ",
        "ORDER BY started_at "
      ]
    },
    {
      "name": "convert_tracker",
      "displayName": "Convert Tracker",
      "queryLines": [
        "SELECT legacy_proc, target_path, status, updated_at ",
        "FROM ops.proc_conversion_map ",
        "ORDER BY updated_at DESC "
      ]
    },
    {
      "name": "event_summary",
      "displayName": "Event Summary",
      "queryLines": [
        "WITH latest AS ( ",
        "  SELECT COALESCE( ",
        "    (SELECT run_id FROM ops.agent_events ORDER BY ts DESC LIMIT 1), ",
        "    (SELECT run_id FROM ops.migration_manifest_current ORDER BY updated_at DESC LIMIT 1) ",
        "  ) AS run_id ",
        ") ",
        "SELECT COUNT(*) AS total_events, ",
        "COUNT(DISTINCT e.run_id) AS runs, ",
        "COUNT(DISTINCT e.agent) AS agents ",
        "FROM ops.agent_events e CROSS JOIN latest ",
        "WHERE e.run_id = latest.run_id "
      ]
    },
    {
      "name": "events_by_agent",
      "displayName": "Events By Agent",
      "queryLines": [
        "WITH latest AS ( ",
        "  SELECT COALESCE( ",
        "    (SELECT run_id FROM ops.agent_events ORDER BY ts DESC LIMIT 1), ",
        "    (SELECT run_id FROM ops.migration_manifest_current ORDER BY updated_at DESC LIMIT 1) ",
        "  ) AS run_id ",
        ") ",
        "SELECT agent, COUNT(*) AS events ",
        "FROM ops.agent_events e CROSS JOIN latest ",
        "WHERE e.run_id = latest.run_id ",
        "GROUP BY agent ",
        "ORDER BY events DESC "
      ]
    },
    {
      "name": "events_over_time",
      "displayName": "Events Over Time",
      "queryLines": [
        "WITH latest AS ( ",
        "  SELECT COALESCE( ",
        "    (SELECT run_id FROM ops.agent_events ORDER BY ts DESC LIMIT 1), ",
        "    (SELECT run_id FROM ops.migration_manifest_current ORDER BY updated_at DESC LIMIT 1) ",
        "  ) AS run_id ",
        ") ",
        "SELECT date_trunc('MINUTE', ts) AS minute, agent, COUNT(*) AS events ",
        "FROM ops.agent_events e CROSS JOIN latest ",
        "WHERE e.ts >= current_timestamp() - INTERVAL 24 HOURS ",
        "AND e.run_id = latest.run_id ",
        "GROUP BY 1, 2 ",
        "ORDER BY 1 "
      ]
    },
    {
      "name": "latest_events",
      "displayName": "Latest Events",
      "queryLines": [
        "WITH latest AS ( ",
        "  SELECT COALESCE( ",
        "    (SELECT run_id FROM ops.agent_events ORDER BY ts DESC LIMIT 1), ",
        "    (SELECT run_id FROM ops.migration_manifest_current ORDER BY updated_at DESC LIMIT 1) ",
        "  ) AS run_id ",
        ") ",
        "SELECT e.run_id, agent, event, tool, detail, ts ",
        "FROM ops.agent_events e CROSS JOIN latest ",
        "WHERE e.run_id = latest.run_id ",
        "ORDER BY ts DESC ",
        "LIMIT 100 "
      ]
    }
  ],
