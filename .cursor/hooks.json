{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": ".cursor/hooks/log_event.sh",
        "failClosed": false,
        "timeout": 30
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/log_event.sh",
        "failClosed": false,
        "timeout": 15
      },
      {
        "command": ".cursor/hooks/on_subagent_stop.sh",
        "failClosed": true,
        "timeout": 60,
        "loop_limit": 2
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/log_event.sh",
        "failClosed": false,
        "timeout": 15
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/log_event.sh",
        "failClosed": false,
        "timeout": 15
      },
      {
        "command": ".cursor/hooks/on_provision_guard.sh after-shell",
        "failClosed": false,
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/on_provision_guard.sh stop",
        "failClosed": false,
        "timeout": 15,
        "loop_limit": 2
      }
    ],
    "afterMCPExecution": [
      {
        "command": ".cursor/hooks/log_event.sh",
        "failClosed": false,
        "timeout": 15
      }
    ]
  }
}
