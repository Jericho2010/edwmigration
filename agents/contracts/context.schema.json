{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://edw-migration.demo/agents/contracts/context.schema.json",
  "title": "Agent run context",
  "description": "Shared input for every stage. Written by the coordinator at kickoff from .env + discovery.",
  "type": "object",
  "required": ["run_id", "foreign_catalog", "uc_catalog", "databricks_host", "max_retries"],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "foreign_catalog": {
      "type": "string",
      "description": "UC foreign catalog mirroring the Azure SQL database.",
      "minLength": 1
    },
    "uc_catalog": {
      "type": "string",
      "description": "User-chosen managed UC catalog for bronze/silver/gold/ops.",
      "minLength": 1
    },
    "source_database": {
      "type": "string",
      "description": "Azure SQL database name."
    },
    "legacy_proc_schema": {
      "type": "string",
      "description": "Optional hint; discovery enumerates all user proc schemas."
    },
    "scoped_tables": {
      "type": "array",
      "description": "Discovered landing names (filled after inventory).",
      "items": { "type": "string" }
    },
    "databricks_host": {
      "type": "string",
      "format": "uri"
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "demo_mode": {
      "type": "boolean",
      "description": "True when launched from edw-demo-guide."
    }
  }
}
