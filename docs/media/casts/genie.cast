[22.151867, "o", "--- generated SQL ---\r\nSELECT stock_item_name, SUM(gross_revenue) AS gross_revenue, SUM(profit) AS profit, SUM(quantity_sold) AS quantity_sold FROM edw_migration.gold.mart_daily_internet_sales WHERE stock_item_name IS NOT NULL GROUP BY stock_item_name ORDER BY gross_revenue DESC LIMIT 10\r\n--- result ---\r\n"]
