# Copy to repo-root .env (gitignored). Never commit real credentials.
#
# Guided demo (recommended): after `az login` + Databricks auth, run
#   ./agents/tools/materialize_demo_env.sh
# instead of filling this by hand.

# --- Azure (demo bootstrap / path A) ---
AZ_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZ_LOCATION=eastus
AZ_RG=rg-edw-migration-demo
AZ_SQL_SERVER=sql-edwmig-<unique-suffix>
AZ_SQL_ADMIN=edwadmin
AZ_SQL_PASSWORD=ReplaceWithAStrongPassword!
AZ_SQL_DB=WideWorldImportersDW
# Optional FQDN override:
# AZ_SQL_HOST=sql-edwmig-xxx.database.windows.net

# --- Databricks sink ---
DATABRICKS_HOST=https://dbc-XXXXXX.cloud.databricks.com
# PAT now; OAuth (`databricks auth login`) is the enterprise target state.
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABRICKS_WAREHOUSE_ID=XXXXXXXXXXXXXXXX
DATABRICKS_CATALOG=edw_migration
DATABRICKS_SECRET_SCOPE=edw-migration

# --- Federation names (optional) ---
FOREIGN_CATALOG=wwi_dw_fed
CONNECTION_NAME=azure_sql_edw

# Bundle:
#   export BUNDLE_VAR_warehouse_id="$DATABRICKS_WAREHOUSE_ID"
#   export BUNDLE_VAR_catalog="$DATABRICKS_CATALOG"
