# Azure SQL EDW — copy this file to .env and fill in values.
# .env is gitignored. Never commit real credentials.

# --- Azure ---
AZ_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZ_LOCATION=eastus
AZ_RG=rg-edw-migration-demo
# Globally unique server name (lowercase, 3-63 chars, [a-z0-9-]):
AZ_SQL_SERVER=sql-edwmig-<your-unique-suffix>
AZ_SQL_ADMIN=edwadmin
AZ_SQL_PASSWORD=ReplaceWithAStrongPassword!

# --- WideWorldImportersDW ---
AZ_SQL_DB=WideWorldImportersDW

# --- Databricks Free Edition ---
DATABRICKS_HOST=https://dbc-XXXXXX.cloud.databricks.com
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# The Free Edition serverless SQL warehouse ID (2X-Small). Find it in the UI
# or via: databricks warehouses list
DATABRICKS_WAREHOUSE_ID=XXXXXXXXXXXXXXXX

# --- Databricks secrets scope (created by bootstrap.sh) ---
DATABRICKS_SECRET_SCOPE=edw-migration
