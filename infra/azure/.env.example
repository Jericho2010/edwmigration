# Copy to repo-root .env (gitignored). Never commit real credentials.
#
# Track A: ./agents/tools/materialize_demo_env.sh after az + Databricks login
# Track B: fill SOURCE_* + Databricks sink, then make setup

# --- Source ---
SOURCE_TYPE=sqlserver
SOURCE_HOST=
SOURCE_PORT=1433
SOURCE_DATABASE=
SOURCE_USER=
SOURCE_PASSWORD=
# MySQL: SOURCE_TYPE=mysql SOURCE_PORT=3306
# Optional: SOURCE_TRUST_SERVER_CERTIFICATE=true (MySQL default)

# Demo bootstrap only (Track A) — materialize fills these:
# AZ_SUBSCRIPTION_ID=...
# AZ_SQL_SERVER=...
# AZ_SQL_ADMIN=edwadmin
# AZ_SQL_PASSWORD=...
# AZ_SQL_DB=WideWorldImportersDW

# --- Databricks sink ---
DATABRICKS_HOST=https://dbc-XXXXXX.cloud.databricks.com
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABRICKS_WAREHOUSE_ID=XXXXXXXXXXXXXXXX
DATABRICKS_CATALOG=edw_migration
DATABRICKS_SECRET_SCOPE=edw-migration

# Optional federation names (auto: wwi_dw_fed / azure_sql_edw or mysql_fed / azure_mysql_edw)
# FOREIGN_CATALOG=
# CONNECTION_NAME=
